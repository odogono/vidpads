{
  "name": "video-operator-pads",
  "author": "Alexander Veenendaal <alex@opendoorgonorth.com>",
  "version": "1.15.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "prebuild": "node bin/generate-build-time.ts",
    "build": "pnpm run typecheck && vite build && vite build --ssr server/index.ts --outDir dist-server",
    "deploy": "dotenv -e .env.deploy -- pnpm run build && sh deploy",
    "start:docker": "pnpm start",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --ignore-path .gitignore --write \"./src/**/*.+(js|ts|json)\"",
    "prettier:fix": "prettier --write src",
    "outdated": "npx npm-check-updates --interactive --format group",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:update": "vitest run --update"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@heroui/react": "2.7.2",
    "@tanstack/react-query": "^5.66.9",
    "@xstate/store": "^3.1.0",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "deep-object-diff": "^1.1.9",
    "framer-motion": "^11.18.1",
    "lucide-react": "^0.475.0",
    "mitt": "^3.0.1",
    "pako": "^2.1.0",
    "prismjs": "^1.29.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.2",
    "react-router": "^7.15.1"
  },
  "devDependencies": {
    "@babel/runtime": "^7.26.9",
    "@cloudflare/workers-types": "^4.20250214.0",
    "@eslint/js": "^9.21.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/kode-mono": "^5.2.8",
    "@fontsource/suse": "^5.2.9",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@playwright/test": "^1.60.0",
    "@statelyai/inspect": "^0.4.0",
    "@tanstack/react-query-devtools": "^5.66.9",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/bun": "^1.2.3",
    "@types/node": "^22",
    "@types/pako": "^2.0.4",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/webmidi": "^2.1.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "clsx": "^2.1.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prefer-arrow-functions": "3.6.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.0.0-beta-e552027-20250112",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "prettier": "^3.5.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-motion": "^1.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "typescript-eslint": "^8.24.1",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@heroui/shared-utils",
      "esbuild",
      "sharp"
    ]
  },
  "type": "module"
}
